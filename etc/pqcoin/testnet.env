# Environment overrides for pqcoin testnet instance
# This file is sourced by systemd before starting the service.
#
# Add extra command-line arguments here:
# PQCOIN_EXTRA_ARGS=--mine --log-level debug
#
# Common options:
#   --mine                 Enable mining
#   --log-level <level>    Set log level (trace, debug, info, warn, error)
#   -C <addr:port>         Connect to specific peer
#
# Example for LAN testnet (desktop miner connecting to MacBook):
# PQCOIN_EXTRA_ARGS=--mine -C 100.120.248.123:18333

# Note: --testnet is automatically applied via config file
PQCOIN_EXTRA_ARGS=
