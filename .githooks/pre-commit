#!/bin/sh
# Pre-commit hook to run cargo fmt and clippy

set -e

# Check formatting
echo "Checking formatting..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo ""
    echo "Code is not formatted. Running cargo fmt..."
    cargo fmt --all
    echo ""
    echo "Files have been formatted. Please stage the changes and commit again."
    exit 1
fi

# Run clippy
echo "Running clippy..."
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo ""
    echo "Clippy found warnings. Please fix them before committing."
    exit 1
fi

# Build whitepaper PDF
echo "Building whitepaper PDF..."
if command -v pdflatex >/dev/null 2>&1; then
    cd whitepaper || exit 1
    # First pass for initial compilation
    pdflatex -interaction=nonstopmode pqcoin.tex > /dev/null 2>&1
    # Second pass for cross-references and TOC
    pdflatex -interaction=nonstopmode pqcoin.tex > /dev/null 2>&1
    LATEX_EXIT=$?
    cd ..

    if [ $LATEX_EXIT -ne 0 ]; then
        echo "Whitepaper build failed. Please fix LaTeX errors."
        exit 1
    fi

    # Stage updated PDF if changed
    if git diff --name-only whitepaper/pqcoin.pdf 2>/dev/null | grep -q .; then
        git add whitepaper/pqcoin.pdf
        echo "Whitepaper PDF updated and staged."
    fi
else
    echo "Warning: pdflatex not found, skipping whitepaper build"
fi

echo "All checks passed!"
exit 0
