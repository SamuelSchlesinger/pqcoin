#!/bin/sh
# Pre-commit hook to run cargo fmt and clippy

set -e

# Check formatting
echo "Checking formatting..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo ""
    echo "Code is not formatted. Running cargo fmt..."
    cargo fmt --all
    echo ""
    echo "Files have been formatted. Please stage the changes and commit again."
    exit 1
fi

# Run clippy
echo "Running clippy..."
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo ""
    echo "Clippy found warnings. Please fix them before committing."
    exit 1
fi

echo "All checks passed!"
exit 0
